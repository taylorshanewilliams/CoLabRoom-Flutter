<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Calls in a room (0134). The camera is asked for at the first call,
         never before; a phone without one still installs the app and calls
         with sound. Audio settings route a call to headphones and Bluetooth;
         network state lets WebRTC notice a change from Wi-Fi to mobile. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application
        android:label="CoLabRoom"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase OAuth/magic-link redirect back into the app; scheme
                 must match BetaConfig.authRedirectUrl in lib/app/beta_config.dart. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.colabroom.beta" android:host="login-callback"/>
            </intent-filter>
            <!-- Links to app.colabroom.com open the app when it is installed:
                 a lesson QR code, somebody's code for meeting in person, an
                 invitation, a song somebody sent. Android
                 checks https://app.colabroom.com/.well-known/assetlinks.json
                 (web/.well-known in this repo) at install before it trusts
                 this, and the file must name the key the APK is signed with.
                 By path, never the root: password resets and account deletion
                 land on app.colabroom.com/?... and only work in a browser.
                 Every prefix here must be one the app opens; see
                 test/a_link_opens_the_app_test.dart. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="app.colabroom.com"/>
                <data android:pathPrefix="/lesson/"/>
                <data android:pathPrefix="/invite/"/>
                <data android:pathPrefix="/add/"/>
                <data android:pathPrefix="/song/"/>
                <data android:pathPrefix="/room/"/>
                <data android:pathPrefix="/musician/"/>
                <data android:pathPrefix="/heard/"/>
                <data android:pathPrefix="/set/"/>
                <!-- A moment of a recording inside a room:
                     /r/<room>/s/<song>?take=&amp;at=. Without this a link a
                     bandmate texts opens Chrome on a phone that has the app,
                     and nothing in the app ever sees it. Android reads this
                     file at install, so it takes a new build. -->
                <data android:pathPrefix="/r/"/>
            </intent-filter>
        </activity>
        <!-- Must name a channel the app has actually created; see
             NotificationShade.channelId. Naming one that does not exist
             makes Android drop every notification that arrives while the
             app is closed, silently. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="colabroom_default" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Showcase links open outside the app. Without this, Android 11 and
             later hide every browser from us and the link silently does
             nothing. https only: the link allowlist admits no other scheme. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- The phone's own voice, which Perform uses to call the next chord
             a beat before it lands. Android 11 and later hide the
             text-to-speech engine from an app that has not asked to see it,
             and then the voice binds to nothing and says nothing at all: no
             error, no log, just a setting somebody turned on and never heard
             (see ChordVoice, and flutter_tts's own README). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
